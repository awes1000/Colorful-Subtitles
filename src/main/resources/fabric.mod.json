{
	"schemaVersion": 1,
	"id": "colorfulsubtitles",
	"version": "${version}",
	"name": "Colorful Subtitles",
	"description": "Changes the color of subtitles based on their sound category.",
	"authors": [
		"awes1000",
		"haykam821"
	],
	"contact": {
		"homepage": "https://github.com/awes1000/Colorful-Subtitles#readme",
		"issues": "https://github.com/awes1000/Colorful-Subtitles/issues",
		"sources": "https://github.com/awes1000/Colorful-Subtitles"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.haykam821.colorfulsubtitles.ColorfulSubtitlesClient"
		],
		"modmenu": [
			"io.github.haykam821.colorfulsubtitles.modmenu.ColorfulSubtitlesModMenu"
		]
	},
	"mixins": [
		"colorfulsubtitles.mixin.json"
	],
	"accessWidener": "colorfulsubtitles.accesswidener",
	"license": "MIT",
	"icon": "assets/colorfulsubtitles/icon.png",
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_version}",
		"cloth-config": ">=${cloth_config_version}"
	},
	"recommends": {
		"modmenu": "*"
	}
}
